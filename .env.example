# Set ONE provider key. The provider is inferred from whichever is present,
# so nothing else needs configuring.
GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional - defaults shown
# AGENT_PROVIDER=groq              # anthropic | groq | openai | local
# AGENT_MODEL=                     # blank = provider preset, or best available on Groq
# AGENT_VERIFIER_MODEL=            # defaults to AGENT_MODEL
# AGENT_BASE_URL=                  # only for --provider local (e.g. Ollama)

# Environment under automation
# ACMEOPS_URL=http://127.0.0.1:8099
# ACMEOPS_CHAOS=on                 # off disables failure injection
# ACMEOPS_CHAOS_SEED=7
